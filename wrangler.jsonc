{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "headwaters",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public lets the OAuth layer fetch client metadata documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Served from the custom domain only; the account has no workers.dev subdomain.
  "workers_dev": false,
  "routes": [{ "pattern": "headwaters.polyculture.net", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    // Everything that needs the Worker (API, MCP, OAuth, login) runs before static assets.
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/login",
      "/invite/*",
      "/logout"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "headwaters",
      "database_id": "0ec40209-4335-4e8b-b543-1c2699453ccf",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // OAuth grants and tokens for MCP clients, plus login throttling.
      "binding": "OAUTH_KV",
      "id": "2d4fe40b287b467d91b8f49fbd7405c6"
    }
  ]
}
